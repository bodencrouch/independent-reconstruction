{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "observation",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
    },
    "kind": {
      "enum": [
        "api-trace",
        "binary-behavior",
        "documentation",
        "source-analysis",
        "experiment",
        "user-requirement"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "origin": {
      "type": "object",
      "properties": {
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        }
      },
      "required": [
        "locator",
        "sha256",
        "license"
      ],
      "additionalProperties": false
    },
    "confidence": {
      "enum": [
        "observed",
        "inferred",
        "unknown"
      ]
    }
  },
  "required": [
    "id",
    "kind",
    "summary",
    "origin",
    "confidence"
  ],
  "additionalProperties": false
}
