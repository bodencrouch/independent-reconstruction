{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "incident",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "affected_roles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "minItems": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
      },
      "minItems": 0
    },
    "containment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "recovery": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    }
  },
  "required": [
    "kind",
    "summary",
    "affected_roles",
    "evidence_ids",
    "containment",
    "recovery"
  ],
  "additionalProperties": false
}
