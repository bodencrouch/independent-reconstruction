{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "probe-plan",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "probes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
          },
          "input": {},
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          }
        },
        "required": [
          "id",
          "input",
          "summary",
          "license"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "probes"
  ],
  "additionalProperties": false
}
