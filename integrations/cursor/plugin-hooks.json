{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "sh \"${CURSOR_PLUGIN_ROOT}/hooks/entry.sh\" cursor preToolUse",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "sh \"${CURSOR_PLUGIN_ROOT}/hooks/entry.sh\" cursor beforeShellExecution",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "sh \"${CURSOR_PLUGIN_ROOT}/hooks/entry.sh\" cursor beforeMCPExecution",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeReadFile": [
      {
        "command": "sh \"${CURSOR_PLUGIN_ROOT}/hooks/entry.sh\" cursor beforeReadFile",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeTabFileRead": [
      {
        "command": "sh \"${CURSOR_PLUGIN_ROOT}/hooks/entry.sh\" cursor beforeTabFileRead",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "sh \"${CURSOR_PLUGIN_ROOT}/hooks/entry.sh\" cursor beforeSubmitPrompt",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "subagentStart": [
      {
        "command": "sh \"${CURSOR_PLUGIN_ROOT}/hooks/entry.sh\" cursor subagentStart",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "sessionStart": [
      {
        "command": "sh \"${CURSOR_PLUGIN_ROOT}/hooks/entry.sh\" cursor sessionStart",
        "timeout": 10
      }
    ],
    "sessionEnd": [
      {
        "command": "sh \"${CURSOR_PLUGIN_ROOT}/hooks/entry.sh\" cursor sessionEnd",
        "timeout": 10
      }
    ],
    "postToolUse": [
      {
        "command": "sh \"${CURSOR_PLUGIN_ROOT}/hooks/entry.sh\" cursor postToolUse",
        "timeout": 10
      }
    ],
    "postToolUseFailure": [
      {
        "command": "sh \"${CURSOR_PLUGIN_ROOT}/hooks/entry.sh\" cursor postToolUseFailure",
        "timeout": 10
      }
    ],
    "afterFileEdit": [
      {
        "command": "sh \"${CURSOR_PLUGIN_ROOT}/hooks/entry.sh\" cursor afterFileEdit",
        "timeout": 10
      }
    ],
    "afterTabFileEdit": [
      {
        "command": "sh \"${CURSOR_PLUGIN_ROOT}/hooks/entry.sh\" cursor afterTabFileEdit",
        "timeout": 10
      }
    ],
    "afterShellExecution": [
      {
        "command": "sh \"${CURSOR_PLUGIN_ROOT}/hooks/entry.sh\" cursor afterShellExecution",
        "timeout": 10
      }
    ],
    "afterMCPExecution": [
      {
        "command": "sh \"${CURSOR_PLUGIN_ROOT}/hooks/entry.sh\" cursor afterMCPExecution",
        "timeout": 10
      }
    ],
    "subagentStop": [
      {
        "command": "sh \"${CURSOR_PLUGIN_ROOT}/hooks/entry.sh\" cursor subagentStop",
        "timeout": 10,
        "loop_limit": 0
      }
    ],
    "preCompact": [
      {
        "command": "sh \"${CURSOR_PLUGIN_ROOT}/hooks/entry.sh\" cursor preCompact",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "sh \"${CURSOR_PLUGIN_ROOT}/hooks/entry.sh\" cursor stop",
        "timeout": 10,
        "loop_limit": 0
      }
    ]
  }
}
