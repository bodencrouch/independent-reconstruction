{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "sh .cursor/hooks/independent-reconstruction/entry.sh cursor preToolUse",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "sh .cursor/hooks/independent-reconstruction/entry.sh cursor beforeShellExecution",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "sh .cursor/hooks/independent-reconstruction/entry.sh cursor beforeMCPExecution",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeReadFile": [
      {
        "command": "sh .cursor/hooks/independent-reconstruction/entry.sh cursor beforeReadFile",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeTabFileRead": [
      {
        "command": "sh .cursor/hooks/independent-reconstruction/entry.sh cursor beforeTabFileRead",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "sh .cursor/hooks/independent-reconstruction/entry.sh cursor beforeSubmitPrompt",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "subagentStart": [
      {
        "command": "sh .cursor/hooks/independent-reconstruction/entry.sh cursor subagentStart",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "sessionStart": [
      {
        "command": "sh .cursor/hooks/independent-reconstruction/entry.sh cursor sessionStart",
        "timeout": 10
      }
    ],
    "sessionEnd": [
      {
        "command": "sh .cursor/hooks/independent-reconstruction/entry.sh cursor sessionEnd",
        "timeout": 10
      }
    ],
    "postToolUse": [
      {
        "command": "sh .cursor/hooks/independent-reconstruction/entry.sh cursor postToolUse",
        "timeout": 10
      }
    ],
    "postToolUseFailure": [
      {
        "command": "sh .cursor/hooks/independent-reconstruction/entry.sh cursor postToolUseFailure",
        "timeout": 10
      }
    ],
    "afterFileEdit": [
      {
        "command": "sh .cursor/hooks/independent-reconstruction/entry.sh cursor afterFileEdit",
        "timeout": 10
      }
    ],
    "afterTabFileEdit": [
      {
        "command": "sh .cursor/hooks/independent-reconstruction/entry.sh cursor afterTabFileEdit",
        "timeout": 10
      }
    ],
    "afterShellExecution": [
      {
        "command": "sh .cursor/hooks/independent-reconstruction/entry.sh cursor afterShellExecution",
        "timeout": 10
      }
    ],
    "afterMCPExecution": [
      {
        "command": "sh .cursor/hooks/independent-reconstruction/entry.sh cursor afterMCPExecution",
        "timeout": 10
      }
    ],
    "subagentStop": [
      {
        "command": "sh .cursor/hooks/independent-reconstruction/entry.sh cursor subagentStop",
        "timeout": 10,
        "loop_limit": 0
      }
    ],
    "preCompact": [
      {
        "command": "sh .cursor/hooks/independent-reconstruction/entry.sh cursor preCompact",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "sh .cursor/hooks/independent-reconstruction/entry.sh cursor stop",
        "timeout": 10,
        "loop_limit": 0
      }
    ]
  }
}
